OVYRO_ADMIN_EMAIL=admin@example.com
OVYRO_ADMIN_PASSWORD_HASH=<salt-hex>:<scrypt-hash-hex>
OVYRO_SESSION_SECRET=<random-secret>
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Vercel's Supabase integration may provide POSTGRES_URL; it takes precedence
# over DATABASE_URL when both are set.
